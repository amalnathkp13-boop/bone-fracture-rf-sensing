__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
.venv/

# simulation artefacts (regenerate via scripts/, never commit)
runs/
out/
*.h5
*.hdf5
*.vti
*.vtp
*.npz
# figures/ IS committed, deliberately. Every figure is regenerated by
# scripts/make_figures.py - but only from runs/, which is roughly a gigabyte of
# solver output and is not hosted here. Ignoring both would leave a repository
# that cannot show its own results and cannot rebuild them either. 3.5 MB of
# PNGs is the cheapest way to make it stand alone.

# gprMax generated input decks
*.in
!config/*.in

# generated for upload, regenerate with scripts/package_for_colab.py
bonesim_colab.zip

# LaTeX build artefacts; paper.tex and paper.pdf ARE committed
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/pg-*.jpg
